#!name = 酷狗概念版每日 VIP
#!desc = 从已登录的酷狗概念版请求保存凭证，每天核对记录后领取当天 VIP
#!author = changeCat
#!homepage = https://github.com/changeCat/kugou-concept-vip-loon
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(983)
#!tag = 酷狗,签到
#!type = normal

[Argument]
refresh_enabled = switch,true,tag=后台凭证更新,desc=打开概念版时从普通请求验证新Token并更新已有配置；会产生运行记录，无需进入VIP页面
signature_debug = switch,false,tag=临时签名诊断,desc=核对App活动请求并保存已验签的查询和领取配置；操作后关闭，再运行检查App签名
capture_enabled = switch,true,tag=启用凭证捕获,desc=保存凭证后可关闭以停止捕获记录；登录失效或切换账号时重新开启
capture_wide = switch,false,tag=临时扩大捕获范围,desc=默认只捕获 youth 活动请求；个人或VIP页面无法捕获时临时开启，用完关闭
enabled = switch,false,tag=启用自动领取,desc=先打开酷狗获取凭证并手动验收，再开启定时
cron = input,"0 6 * * *",tag=领取时间,desc=按设备本地时区，每天 06:00；已有安装请手动修改旧值

[Script]
request if ${url} ~= /^https:\/\/gateway\.kugou\.com\/(?!youth\/v1\/(?:activity\/get_month_vip_record|recharge\/receive_vip_listen_song)(?:[?#]|$))/i && (${url} ~= /[?&]appid=3114(?:&|$)/i || ${request.header['appid']} == "3114" || ${request.header['Authorization']} ~= /(?:^|[;&\s])appid=3114(?:[;&\s]|$)/i || ${request.header['Cookie']} ~= /(?:^|[;&\s])appid=3114(?:[;&\s]|$)/i) && (${url} ~= /[?&](?:token|clienttoken)=[^&]+/i || ${request.header['Cookie']} ~= /(?:^|[;&\s])(?:token|clienttoken)=/i || ${request.header['Authorization']} ~= /(?:^|[;&\s])(?:token|clienttoken)=/i) then script("https://raw.githubusercontent.com/changeCat/kugou-concept-vip-loon/main/claim.js", "refresh") with enable=${refresh_enabled}, tag="酷狗后台凭证更新", timeout=20
response if ${url} ~= /^https:\/\/gateway\.kugou\.com\/youth\//i && (${request.method} == "GET" || ${request.method} == "POST") && ${response.status} == 200 then script("https://raw.githubusercontent.com/changeCat/kugou-concept-vip-loon/main/signature-check.js") with enable=${signature_debug}, tag="酷狗签名本地核对", requires_body=true, timeout=20
request if ${url} ~= /^https:\/\/gateway\.kugou\.com\//i && (${url} ~= /^https:\/\/gateway\.kugou\.com\/youth\//i || ${capture_wide} == true) && (${url} ~= /[?&](?:token|clienttoken)=[^&]+/i || ${request.header['Cookie']} ~= /(?:^|[;&\s])(?:token|clienttoken)=/i || ${request.header['Authorization']} ~= /(?:^|[;&\s])(?:token|clienttoken)=/i) then script("https://raw.githubusercontent.com/changeCat/kugou-concept-vip-loon/main/capture.js") with enable=${capture_enabled}, tag="酷狗凭证捕获", timeout=20
cron ${cron} then script("https://raw.githubusercontent.com/changeCat/kugou-concept-vip-loon/main/claim.js") with enable=${enabled}, tag="酷狗每日 VIP", timeout=120
generic then script("https://raw.githubusercontent.com/changeCat/kugou-concept-vip-loon/main/claim.js", "manual") with tag="手动核对并领取 VIP", timeout=120
generic then script("https://raw.githubusercontent.com/changeCat/kugou-concept-vip-loon/main/claim.js", "web_trial") with tag="测试 Web 领取（当天一次）", timeout=120
generic then script("https://raw.githubusercontent.com/changeCat/kugou-concept-vip-loon/main/claim.js", "query") with tag="仅查询 VIP 记录", timeout=60
generic then script("https://raw.githubusercontent.com/changeCat/kugou-concept-vip-loon/main/diagnose.js") with tag="检查酷狗捕获状态", timeout=20
generic then script("https://raw.githubusercontent.com/changeCat/kugou-concept-vip-loon/main/signature-check.js") with tag="检查 App 签名", timeout=20
generic then script("https://raw.githubusercontent.com/changeCat/kugou-concept-vip-loon/main/signature-check.js", "clear") with tag="清除签名诊断摘要", timeout=20

[MitM]
hostname = *.kugou.com
